@model Product

<div class="field">
    <label asp-for="Name">Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="error"></span>
</div>

<div class="field">
    <label asp-for="Category">Category</label>
    <input asp-for="Category" />
    <span asp-validation-for="Category" class="error"></span>
</div>

<div class="field">
    <label asp-for="Price">Price</label>
    <input asp-for="Price" type="number" step="0.01" />
    <span asp-validation-for="Price" class="error"></span>
</div>

<div class="field">
    <label asp-for="Description">Description</label>
    <textarea asp-for="Description" rows="3"></textarea>
    <span asp-validation-for="Description" class="error"></span>
</div>
