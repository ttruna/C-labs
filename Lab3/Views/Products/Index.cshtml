@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<form method="get" class="filter">
    <input type="text" name="name" value="@Model.Name" placeholder="Name contains" />

    <select name="category">
        <option value="">All categories</option>
        @foreach (var c in Model.Categories)
        {
            <option value="@c" selected="@string.Equals(c, Model.Category, StringComparison.OrdinalIgnoreCase)">@c</option>
        }
    </select>

    <input type="number" step="0.01" name="minPrice" value="@Model.MinPrice" placeholder="Min price" />
    <input type="number" step="0.01" name="maxPrice" value="@Model.MaxPrice" placeholder="Max price" />

    <input type="submit" value="Filter" />
    <a asp-action="Index">Reset</a>
</form>

<p>Found: @Model.Products.Count</p>

<table class="table">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Category</th><th>Price</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Category</td>
                <td>@p.Price.ToString("F2")</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@p.Id">View</a>
                    <a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a asp-action="Create">Add a new product</a></p>
