@{
    ViewData["Title"] = "Product Info";

    // list of products is created just within the view
    var products = new List<Product>
    {
        new Product { Name = "Milk",   Price = 42.50 },
        new Product { Name = "Bread",  Price = 25.00 },
        new Product { Name = "Eggs",   Price = 60.90 },
        new Product { Name = "Apples", Price = 35.75 },
        new Product { Name = "Cheese", Price = 180.00 }
    };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<h1>Product Info</h1>

<table class="table">
    <thead>
        <tr><th>#</th><th>Name</th><th>Price</th></tr>
    </thead>
    <tbody>
        @for (int i = 0; i < products.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@products[i].Name</td>
                <td>@products[i].Price.ToString("F2", inv)</td>
            </tr>
        }
    </tbody>
</table>
